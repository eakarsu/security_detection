# Database Configuration
POSTGRES_DB=nodeguard
POSTGRES_USER=nodeguard
POSTGRES_PASSWORD=replace-with-a-random-database-secret
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Elasticsearch Configuration
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-a-random-elasticsearch-secret

# Kafka Configuration
KAFKA_PORT=9092
KAFKA_JMX_PORT=9101
ZOOKEEPER_PORT=2181

# API Ports
PYTHON_API_PORT=8001
NODEJS_API_PORT=3003
FRONTEND_PORT=3002
PUBLIC_NODEJS_API_URL=http://localhost:3003
PUBLIC_PYTHON_API_URL=http://localhost:8001
PUBLIC_FRONTEND_URL=http://localhost:3002

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
GRAFANA_PASSWORD=replace-with-a-random-grafana-secret

# Application Configuration
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=nodeguard-auth
JWT_AUDIENCE=nodeguard-api
ENCRYPTION_KEY=replace-with-a-random-32-byte-encryption-key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ALERT_PROVIDER_URL=https://notification-provider.example
ALERT_PROVIDER_TOKEN=replace-with-provider-token

# Investigation case providers (real HTTPS endpoints; no mock fallback)
CASE_STORAGE_URL=https://storage-provider.example
CASE_STORAGE_TOKEN=replace-with-provider-token
CASE_OCR_URL=https://ocr-provider.example
CASE_OCR_TOKEN=replace-with-provider-token
CASE_ESIGN_URL=https://esign-provider.example
CASE_ESIGN_TOKEN=replace-with-provider-token
CASE_FILING_URL=https://filing-provider.example
CASE_FILING_TOKEN=replace-with-provider-token
CASE_TEMPLATE_URL=https://templates-provider.example
CASE_TEMPLATE_TOKEN=replace-with-provider-token
CASE_TEMPLATE_ALLOWED_AUTHORITIES=replace-with-authority-name
CASE_TEMPLATE_ALLOWED_HOSTS=authority.example

# AI Model Configuration
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
FALLBACK_MODEL=openai/gpt-4o-mini
MAX_TOKENS=4000
TEMPERATURE=0.1

# Environment
NODE_ENV=production
LOG_LEVEL=INFO
API_PORT=3003

# Workflow Monitoring Configuration
WORKFLOW_MONITORING_ENABLED=false
WORKFLOW_MONITORING_INTERVAL=300000
